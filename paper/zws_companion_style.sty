% zws_companion_style.sty — house style for the ZWSLab companion paper,
% reproducing the typesetting of Zero Without Stasis (C:\MathUniPapers\repo\paper:
% build.ps1 flags + preamble.tex + titleblock.tex + colophon.tex), 2026-09-03.
%
% ZWS is built by pandoc + Tectonic: A4, 11pt, 2.6 cm margins, Calibri at fontspec scale 1.06 (since 2026-09-08; Latin Modern before) through
% fontspec/unicode-math, sans slate-coloured headings (titlesec), a small-caps running
% head with a centred page number (fancyhdr), MidnightBlue links, small bold-label
% captions, no paragraph indent with 6pt paragraph skip, Okabe-Ito boxed asides
% (no green: the author is deuteranope), a left-aligned sans title block with a thin
% slate-blue rule, and a closing plate. Everything here mirrors those settings so that
% the two papers read as a pair.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{zws_companion_style}[2026/09/08 Zero Without Stasis house style for the companion paper]

% ---- page and fonts (build.ps1: -V papersize=a4 -V fontsize=11pt -V geometry:margin=2.6cm) ----
\RequirePackage[a4paper,margin=2.6cm]{geometry}
\RequirePackage{amsmath}
\RequirePackage{fontspec}
\RequirePackage{unicode-math}
\defaultfontfeatures{Scale=MatchLowercase}
\defaultfontfeatures[\rmfamily]{Ligatures=TeX,Scale=1}
% ---- typeface (build.ps1 since 2026-09-08: -MainFont Calibri, sansfont = mainfont, -FontScale 1.06; R-2026-09-08-8) ----
% The parent sets its body and its headings in Calibri, optically scaled by 1.06 because the class offers only 10, 11
% and 12 pt and Calibri sets small. The parent sets no maths face; the companion carries more mathematics, so the
% default Latin Modern Math is scaled by the same factor to sit at the text's size.
\setmainfont[Scale=1.06]{Calibri}
\setsansfont[Scale=1.06]{Calibri}
\setmathfont[Scale=1.06]{latinmodern-math.otf}
\RequirePackage{microtype}
\RequirePackage{xurl}
\RequirePackage{graphicx}
\RequirePackage{booktabs,array}
\RequirePackage[dvipsnames,svgnames,x11names]{xcolor}
\definecolor{slatedark}{RGB}{35,50,64}
\definecolor{slateblue}{RGB}{53,92,125}

% ---- headings (preamble.tex) ----
\RequirePackage{titlesec}
\renewcommand{\thesection}{\arabic{section}.}
\renewcommand{\thesubsection}{\arabic{section}.\arabic{subsection}}
\renewcommand{\thesubsubsection}{\thesubsection.\arabic{subsubsection}}
\titleformat{\section}{\sffamily\Large\bfseries\color{slatedark}}{\thesection}{0.5em}{}
\titleformat{\subsection}{\sffamily\large\bfseries\color{slateblue}}{\thesubsection}{0.5em}{}
\titleformat{\subsubsection}{\sffamily\bfseries\color{slateblue}}{\thesubsubsection}{0.5em}{}
\titlespacing*{\section}{0pt}{18pt plus 4pt minus 2pt}{8pt plus 2pt}
% Contents list: article.cls reserves 1.5em for the section number, too narrow for
% two-digit labels such as "10." (the number ran into the title). Same code, 2.4em.
% (No \makeatletter here: inside a package "@" is already a letter, and a stray
% \makeatother would break every later "@" command in this file.)
\renewcommand*\l@section[2]{%
  \ifnum \c@tocdepth >\z@
    \addpenalty\@secpenalty
    \addvspace{1.0em \@plus\p@}%
    \setlength\@tempdima{2.4em}%
    \begingroup
      \parindent \z@ \rightskip \@pnumwidth
      \parfillskip -\@pnumwidth
      \leavevmode \bfseries
      \advance\leftskip\@tempdima
      \hskip -\leftskip
      #1\nobreak\hfil \nobreak\hb@xt@\@pnumwidth{\hss #2}\par
    \endgroup
  \fi}
\titlespacing*{\subsection}{0pt}{14pt plus 3pt minus 2pt}{6pt plus 2pt}

% ---- running head and page number (preamble.tex) ----
\RequirePackage{fancyhdr}
\newcommand{\zwsrunninghead}{}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[R]{\footnotesize\scshape\zwsrunninghead}
\fancyfoot[C]{\small\thepage}
\renewcommand{\headrulewidth}{0pt}

% ---- captions, paragraphs, floats ----
\RequirePackage{caption}
\captionsetup{font=small,labelfont=bf,skip=6pt}
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt plus 2pt minus 1pt}
\setlength{\emergencystretch}{3em}
% No stranded single lines: a paragraph may not leave one line alone at the top or bottom of a
% page (or under a top float). Requested by the author on the v0.2.5 proof ("four words floating").
\widowpenalty=10000
\clubpenalty=10000
\displaywidowpenalty=10000
% 2026-09-08: a heading is never left at the foot of a page (LaTeX allows a break between a section title and the
% subsection title that follows it, and did so in the supplement after the typeface change): each heading asks for
% room for itself and a few lines first.
\RequirePackage{needspace}
\RequirePackage{etoolbox}
% Only the section asks (room for its own title, a subsection title and three lines); a guard on the subsection
% itself forces the break right after the section title, which is the fault being cured. Breaks between a
% subsection title and its first lines are already forbidden by the class.
\pretocmd{\section}{\needspace{6\baselineskip}}{}{}
\renewcommand{\topfraction}{0.9}
\renewcommand{\bottomfraction}{0.6}
\renewcommand{\textfraction}{0.08}
\renewcommand{\floatpagefraction}{0.8}
\setlength{\@fptop}{0pt}
\AtBeginDocument{\setkeys{Gin}{keepaspectratio}}

% ---- citations and links (build.ps1: colorlinks, MidnightBlue) ----
\RequirePackage[numbers,sort&compress]{natbib}
\RequirePackage[colorlinks=true,linkcolor=MidnightBlue,urlcolor=MidnightBlue,citecolor=MidnightBlue]{hyperref}
\hypersetup{pdflang={en-GB},pdfcreator={Tectonic}}

% ---- boxed asides (preamble.tex speculation boxes; Okabe-Ito, green deliberately absent) ----
\RequirePackage[most]{tcolorbox}
\definecolor{specSigned}{HTML}{0072B2}
\definecolor{specWild}{HTML}{D55E00}
% 2026-09-05: the KIND is a STAMP, a small white rounded chip in ordinary case on the title bar, as the
% author asked on 26 August ("maybe in its own box like stamp"). Small caps read as shouting to him.
% Mirrors ZWS v1.325 preamble.tex (\specstamp); note BOX_TITLE_BARS_from_ZWS_v1.325_2026-09-05.
\newcommand{\specstamp}[2]{\tcbox[on line,boxsep=1pt,left=3pt,right=3pt,top=0.5pt,bottom=0.5pt,
  colback=white,colframe=white,boxrule=0pt,arc=2pt,
  fontupper=\mdseries\scriptsize\sffamily\color{#1}]{#2}}
\newtcolorbox{sigbox}[2][]{enhanced,#1,
  colback=specSigned!4,colframe=specSigned,boxrule=0.7pt,
  left=7pt,right=7pt,top=6pt,bottom=6pt,arc=2pt,
  fonttitle=\bfseries\footnotesize,coltitle=white,colbacktitle=specSigned,
  title={#2\hfill\specstamp{specSigned}{Significance}},
  fontupper=\footnotesize}
\newtcolorbox{corrbox}[2][]{enhanced,#1,
  colback=specWild!5,colframe=specWild,boxrule=0.7pt,
  left=7pt,right=7pt,top=6pt,bottom=6pt,arc=2pt,
  fonttitle=\bfseries\footnotesize,coltitle=white,colbacktitle=specWild,
  title={#2\hfill\specstamp{specWild}{Withdrawn inference}},
  fontupper=\footnotesize}

% ---- title block (titleblock.tex) and front notice (speculation_boxes.lua, Pandoc()) ----
% #1 title, #2 subtitle, #3 meta lines (author / version+DOI / status). ZWS sets its short title at
% 23/26pt; a document with a long title may lower \zwstitlesize (the companion uses 20/23pt).
\newcommand{\zwstitlesize}{\fontsize{23}{26}}
\newcommand{\zwstitleblock}[3]{%
  \thispagestyle{fancy}%
  \vspace*{-14pt}%
  {\raggedright\noindent\sffamily\zwstitlesize\selectfont\bfseries\color{slatedark}#1\par}%
  \vspace{4pt}{\color{slateblue}\hrule height 0.8pt}\vspace{7pt}%
  {\raggedright\noindent\sffamily\itshape\fontsize{13}{16}\selectfont\color{slateblue}#2\par}%
  \vspace{8pt}%
  {\small\noindent #3\par}%
  \vspace{4pt}}
\newenvironment{frontnotice}{\begingroup\small\itshape\setlength{\parskip}{3pt plus 1pt}}{\par\endgroup}

% ---- closing plate (colophon.tex) ----
% #1 image, #2 image width, #3 motto, #4 description (small grey, may be empty), #5 version line
\newcommand{\zwscolophon}[5]{%
  \clearpage\thispagestyle{fancy}%
  \vspace*{\fill}%
  \begin{center}\includegraphics[width=#2]{#1}\end{center}%
  \begin{center}{\small\itshape #3}\end{center}%
  \begin{center}\parbox{0.86\linewidth}{\centering\footnotesize\textcolor{gray}{#4}}\end{center}%
  \vspace{\fill}%
  \begin{center}{\footnotesize\textcolor{gray}{#5}}\end{center}}
