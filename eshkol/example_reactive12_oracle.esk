;; Generated by ZWSLab. Exact integer local-rule oracle.
;; Rule: example_reactive12
;; Run with: eshkol-run example_reactive12_oracle.esk

(define rule '#(0 4 8 12 64 68 72 76 128 132 142 140 192 196 200 204 1 5 9 13 65 69 73 77 129 133 137 141 193 197 201 205 2 6 202 14 66 70 74 78 139 134 174 136 194 198 10 206 3 7 11 15 67 71 75 79 131 135 130 143 195 199 203 207 16 20 24 28 80 84 88 92 144 148 152 156 208 212 216 220 17 21 25 29 81 85 89 93 145 149 153 157 209 213 217 221 18 22 26 30 82 86 90 94 146 150 40 158 210 214 218 222 19 23 27 31 83 87 91 95 147 151 155 159 211 215 219 223 32 36 154 44 96 100 104 108 172 164 234 160 224 228 169 236 33 37 41 45 97 101 105 109 161 165 232 173 225 229 233 237 46 38 171 34 98 102 226 110 186 166 170 138 106 230 168 238 35 39 43 47 99 103 107 111 163 167 42 175 227 231 235 239 48 52 56 60 112 116 120 124 176 180 184 188 240 244 248 252 49 53 57 61 113 117 121 125 177 181 185 189 241 245 249 253 50 54 58 62 114 118 122 126 178 182 162 190 242 246 250 254 51 55 59 63 115 119 123 127 179 183 187 191 243 247 251 255))
(define seen (make-vector 256 #f))
(define failures 0)

(define (digit code place)
  (modulo (quotient code place) 4))

(define (state-charge state)
  (cond ((= state 1) 1)
        ((= state 2) -1)
        (else 0)))

(define (block-charge code)
  (+ (state-charge (digit code 1))
     (state-charge (digit code 4))
     (state-charge (digit code 16))
     (state-charge (digit code 64))))

(define (check i)
  (if (= i 256)
      #t
      (let ((out (vector-ref rule i)))
        (if (or (< out 0) (>= out 256))
            (begin (display "OUT-OF-RANGE ") (display i) (newline)
                   (set! failures (+ failures 1)))
            (begin
              (if (vector-ref seen out)
                  (begin (display "DUPLICATE-OUTPUT ") (display out) (newline)
                         (set! failures (+ failures 1)))
                  (vector-set! seen out #t))
              (if (not (= (block-charge i) (block-charge out)))
                  (begin (display "CHARGE-FAIL ") (display i)
                         (display " -> ") (display out) (newline)
                         (set! failures (+ failures 1))))))
        (check (+ i 1)))))

(check 0)
(display "RULE example_reactive12: ")
(if (= failures 0)
    (display "PASS -- bijective and exactly charge-preserving on all 256 blocks")
    (begin (display "FAILURES=") (display failures)))
(newline)
